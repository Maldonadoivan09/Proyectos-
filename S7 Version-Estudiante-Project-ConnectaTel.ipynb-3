     ]
    }
   ],
   "source": [
    "# cantidad de nulos para users\n",
    "\n",
    "nulos_users = users.isna().sum()\n",
    "proporcion_users = users.isna().mean()\n",
    "print(\"Cantidad de valores nulos\")\n",
    "print(nulos_users)\n",
    "print(\"Proporción de valores nulos\")\n",
    "print(proporcion_users)"
   ]
  },
