       "unique         6\n",
       "top       Bogotá\n",
       "freq         808\n",
       "Name: city, dtype: object"
      ]
     },
     "execution_count": 21,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Reemplazar ? por NA en city\n",
    "users['city']= users['city'].replace('?',pd.NA)\n",
    "\n",
    "# Verificar cambios\n",
    "users['city'].describe()"
   ]
  },
