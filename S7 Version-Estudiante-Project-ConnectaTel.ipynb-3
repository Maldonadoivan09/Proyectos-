     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "# Visualizando usando BoxPlot \n",
    "columnas_numericas = ['age', 'cant_mensajes', 'cant_llamadas', 'cant_minutos_llamada']\n",
    "\n",
    "for metrics in columnas_numericas:\n",
    "    sns.boxplot(data=user_profile, y=metrics)\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "15c1c4f1",
   "metadata": {},
   "source": [
    "💡Insights: \n",
    "- Age: No presenta outliers. Los valores se encuentran distribuidos aproximadamente entre 18 y 79 años.\n",
    "- cant_mensajes: Presenta outliers superiores a 11 mensajes, correspondientes a usuarios con una actividad de mensajería elevada.\n",
    "- cant_llamadas: Presenta outliers por encima de 10 llamadas, lo que indica que algunos usuarios realizan una cantidad considerablemente mayor de llamadas.\n",
    "- cant_minutos_llamada: Presenta numerosos outliers por encima de aproximadamente 62 minutos, mostrando usuarios con un consumo de llamadas significativamente superior al resto."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "eac0db8c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'age': (0, 108.0)}\n",
      "{'age': (0, 108.0), 'cant_mensajes': (0, 11.5)}\n",
      "{'age': (0, 108.0), 'cant_mensajes': (0, 11.5), 'cant_llamadas': (0, 10.5)}\n",
      "{'age': (0, 108.0), 'cant_mensajes': (0, 11.5), 'cant_llamadas': (0, 10.5), 'cant_minutos_llamada': (0, 61.8575)}\n"
     ]
    }
   ],
   "source": [
    "# Calcular límites con el método IQR\n",
    "columnas_limites = {}\n",
    "for columna in columnas_numericas:\n",
    "    Q1 = user_profile[columna].quantile(0.25)\n",
    "    Q3 = user_profile[columna].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    lower = max(lower, 0)\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "    columnas_limites[columna] = (lower, upper)\n",
    "   \n",
    "\n",
    "    print (columnas_limites)\n"
   ]
  },
